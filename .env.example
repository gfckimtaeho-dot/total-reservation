# ─────────────────────────────────────────────────────────────
# Total Reservation — environment variables (template)
# Copy to .env for local dev; register the same keys in Vercel for production.
# .env itself is gitignored. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Neon Postgres connection string (https://neon.tech → project → Connection Details)
# For Vercel, prefer the POOLED connection string (host contains "-pooler") to
# avoid connection exhaustion under serverless functions.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# JWT signing secret for auth sessions (32+ random bytes, base64 or hex)
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public base URL — used for email links, OG images, magic links.
# Local: http://localhost:3000
# Vercel preview: auto via VERCEL_URL (handled in code)
# Vercel production: https://yeyakgazua.vercel.app  (later: https://yeyakgazua.com)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Admin bootstrap (used by prisma/seed.ts on first deploy)
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""

# Gmail SMTP (M1 magic link / invite / activation mail)
# GMAIL_APP_PASSWORD = Google account app-specific password (NOT your login pw)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Stripe (M5 — leave empty until then; presence triggers Vercel Pro requirement)
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""
