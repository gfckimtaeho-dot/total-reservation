// 호텔 repo (C:\projects\hotelreservation) 의 prisma/schema.prisma 의 복제본.
// 헬스장 admin 이 호텔 DB 의 InviteToken/Business/Subscription/Stay 등을 read/write 하기 위한 prisma client generate 용.
// 호텔 repo 의 schema 는 절대 수정 X (사용자 명시 룰). 변경은 호텔 측이 master.
// 호텔 schema 변경 시 사람 책임 sync = 호텔 측 변경 받아 이 파일에 복사 후 `npm run prisma:generate-hotel`.
// 마지막 sync: 2026-06-05 (Business.cafeNameKo/cafeNameEn 추가 = 호텔 마이그레이션 20260605081544_add_cafe_name).
//
// 헬스장 측 변경 항목 (호텔 원본과 다른 부분):
//   - generator output: `../src/generated/prisma` → `../src/generated/prisma-hotel`
//
// 호텔 DB connection 은 src/lib/hotel-db.ts 에서 PrismaPg adapter 로 HOTEL_DATABASE_URL 주입.
// Prisma 7 부터 schema 안 datasource.url 박기 금지 (config / adapter 만 허용).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-hotel"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ─────────────────────────────────────────────────

// 호텔 db 안의 User/Staff 의 role. 기획서 01 의 역할 7종. 헬스장의
// ADMIN/TRAINER/CUSTOMER 는 호텔에 없음. 화면을 한 화면씩 만들며 사용 시점에 도입:
// OWNER/MANAGER(가입·대시보드), CLEANER(직원관리 08), ROOM_TABLET/COFFEE_TABLET/
// COFFEE_MANAGER(태블릿·커피숍 12/13), MANAGER_PHONE(전화받는 매니저, Call 기능).
enum Role {
  OWNER
  MANAGER
  CLEANER
  ROOM_TABLET
  COFFEE_TABLET
  COFFEE_MANAGER
  MANAGER_PHONE
}

enum UserStatus {
  PENDING
  ACTIVE
  WITHDRAWN
  ANONYMIZED
}

enum BusinessStatus {
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  BLOCKED
}

enum SubscriptionPlan {
  TRIAL
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum MagicLinkPurpose {
  SIGNUP_ACTIVATION
  PASSWORD_RESET
  STAFF_INVITE
}

enum Locale {
  ko
  en
}

enum Gender {
  MALE
  FEMALE
}

// 호텔 객실 상태. DIRTY = 체크아웃 후 자동 (청소 대기). READY = 청소 완료 후 매니저가
// 수동 토글. OUT_OF_ORDER = 수리/장기 미사용.
enum RoomState {
  READY
  IN_USE
  DIRTY
  OUT_OF_ORDER
}

enum CheckInState {
  NOT_CONFIRMED
  CONFIRMED
}

enum CheckOutState {
  NOT_CONFIRMED
  CONFIRMED
}

// 예약 상태 (기획서 04). 체크인 시 STAYING + Stay row 생성(05), 체크아웃 시 CHECKED_OUT.
enum ReservationStatus {
  RESERVED
  STAYING
  CHECKED_OUT
  CANCELLED
}

// 투숙 상태 (기획서 05/15). 헬스장이 cross-DB 로 읽어 출입 판정.
enum StayStatus {
  ACTIVE
  CHECKED_OUT
}

// 정산(folio) 상태 (기획서 05).
enum FolioStatus {
  OPEN
  SETTLED
}

// 결제 수단 (체크아웃 정산 / 매출). 매니저가 대면 수령.
enum PaymentMethod {
  GPAY
  CARD
  CASH
}

// 청소 종류 / 상태 (기획서 07).
enum CleaningType {
  CHECKOUT
  REQUEST
}

enum CleaningStatus {
  PENDING
  IN_PROGRESS
  DONE
}

// 매출 종류 (기획서 14/16). 호텔 매출 = ROOM + ROOM_SERVICE. COFFEE 는 커피숍 몫(분리).
enum RevenueType {
  ROOM
  ROOM_SERVICE
  COFFEE
}

// ─── Business (호텔 가맹점) ────────────────────────────────

model Business {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  phone         String?
  contactEmail  String?
  address       String?
  // 세금계산서 발행용. 한국 사업자만 채움, 필리핀 사장이면 NULL.
  // V1 = 단순 string 4 필드 + 정형화 X. V2 검색/통계 필요 시 분리.
  taxRegistrationNumber String?
  taxLegalName          String?
  taxAddress            String?
  taxBusinessType       String?
  status        BusinessStatus @default(TRIAL)
  blockedReason String?
  // IANA 타임존 - 매장 현지 시간 기준. 필리핀 호텔 default Asia/Manila.
  timeZone      String         @default("Asia/Manila")
  // 체크인/체크아웃 기본 시간 (자정 기준 분, Manila). 15:00 / 11:00.
  defaultCheckInMin  Int @default(900)
  defaultCheckOutMin Int @default(660)
  // 커피숍 이름 (한글/영문). 헬스장 admin 이 커피매니저 발급 시 입력 → cross-DB write.
  // 호텔 마이그레이션 20260605081544_add_cafe_name 으로 적용됨. 둘 다 nullable.
  cafeNameKo    String?
  cafeNameEn    String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  createdById   String?
  updatedById   String?

  users           User[]
  staff           Staff[]
  rooms           Room[]
  roomTypes       RoomType[]
  reservations    Reservation[]
  stays           Stay[]
  folios          Folio[]
  cleaningRecords CleaningRecord[]
  revenueEntries  RevenueEntry[]
  customers       Customer[]
  subscription    Subscription?
  payments        Payment[]
  magicLinkTokens MagicLinkToken[]
  inviteToken     InviteToken?

  @@index([status])
}

// ─── User (가맹점 스코프) ─────────────────────────────────

model User {
  id           String     @id @default(cuid())
  hotelId      String
  business     Business   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  // 로그인 식별자. 매장별 unique. PENDING(활성화 전) row 는 NULL. Postgres NULL
  // distinct 라 NULL row 들끼리는 충돌 안 함.
  loginId      String?
  email        String?
  passwordHash String?
  name         String
  phone        String?
  gender       Gender?
  dob          DateTime?  @db.Date
  note         String?
  role         Role       @default(MANAGER)
  status       UserStatus @default(PENDING)
  active       Boolean    @default(true)
  locale       Locale     @default(ko)
  // 약관 동의. register 시점에 한꺼번에 채워짐. 분쟁 증빙.
  termsAgreedAt   DateTime? @db.Timestamptz(3)
  privacyAgreedAt DateTime? @db.Timestamptz(3)
  billingAgreedAt DateTime? @db.Timestamptz(3)
  termsVersion    String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  createdById  String?
  updatedById  String?

  staff           Staff?
  sessions        Session[]
  accounts        Account[]
  magicLinkTokens MagicLinkToken[]

  @@unique([loginId, hotelId])
  @@index([hotelId, role])
  @@index([hotelId, status])
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  expiresAt   DateTime @db.Timestamptz(3)
  ipAddress   String?
  userAgent   String?
  rememberMe  Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId  String
  accountId   String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@unique([providerId, accountId])
  @@index([userId])
}

// ─── Tokens ────────────────────────────────────────────────

model MagicLinkToken {
  id           String           @id @default(cuid())
  token        String           @unique
  targetUserId String
  targetUser   User             @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  hotelId      String?
  business     Business?        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  purpose      MagicLinkPurpose
  expiresAt    DateTime         @db.Timestamptz(3)
  usedAt       DateTime?        @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  createdById  String?
  updatedById  String?

  @@index([targetUserId, purpose])
  @@index([expiresAt])
}

// 헬스장 admin 이 호텔 가맹점 등록 invite 발급 시 호텔 db 에 직접 write 하는 row.
// cross-DB write = 헬스장 admin 의 prisma client 가 HOTEL_DATABASE_URL 로 연결.
// 호텔 측 register 페이지 (`/[locale]/register?token=XXX`) 가 이 row 읽고 검증.
model InviteToken {
  id                   String    @id @default(cuid())
  token                String    @unique
  expectedBusinessName String?
  expectedOwnerEmail   String?
  expectedOwnerPhone   String?
  expiresAt            DateTime  @db.Timestamptz(3)
  usedAt               DateTime? @db.Timestamptz(3)
  revokedAt            DateTime? @db.Timestamptz(3)
  createdBusinessId    String?   @unique
  createdBusiness      Business? @relation(fields: [createdBusinessId], references: [id])
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  createdById          String?
  updatedById          String?

  @@index([expiresAt])
}

// ─── Staff (사장/매니저 = User 와 1:1 link) ─────────────────

model Staff {
  id          String   @id @default(cuid())
  hotelId     String
  business    Business @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role
  photoUrl    String?
  // 매장 출근 시간 (자정 기준 분, Manila). 호텔은 24시간 운영이 일반적이나 매니저
  // 시프트 표시용. default null = 24시간.
  workStartMin Int?
  workEndMin   Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  // 청소 배정 (다대다, 기획서 07). 청소부 = 활성 CLEANER staff.
  cleanings CleaningRecord[]

  @@index([hotelId, role])
}

// ─── 호텔 도메인: RoomType / Room / Stay / Customer ─────────

// 룸타입 (등급). 객실을 타입에 매핑. 기본가는 참고용, 실제 객실료는 예약별 입력.
// Delete 없음 = 활성/비활성만 (과거 예약이 타입을 참조할 수 있어 보존).
model RoomType {
  id          String   @id @default(cuid())
  hotelId     String
  business    Business @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  // 타입명 (예: A타입, Standard, Suite). 호텔별 unique.
  name        String
  // 침대 수.
  bedCount    Int      @default(1)
  // 욕조 유무.
  hasBathtub  Boolean  @default(false)
  // 크기 - free-text (㎡/평/"32 sqm" 등 호텔마다 표기 제각각). 정형화는 V2.
  size        String?
  // 기본 1박 가격 (PHP) - 참고용. 실제 객실료는 예약 시 매니저 입력값 우선.
  basePricePhp Int     @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  rooms        Room[]
  reservations Reservation[]

  @@unique([hotelId, name])
  @@index([hotelId, isActive])
}

model Room {
  id          String    @id @default(cuid())
  hotelId     String
  business    Business  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  // 방번호 (101, 102, ..., 901, 902...). 호텔별 unique.
  roomNumber  String
  // 층 번호. 9F 의 901 호 = floor 9.
  floor       Int?
  // 룸타입 (등급) 참조. 방 먼저 만들고 타입 나중 지정 가능 = nullable.
  roomTypeId  String?
  roomType    RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  // 기본 1박 가격 (PHP). 시즌 가격은 V2 (별 모델).
  basePricePhp Int
  state       RoomState @default(READY)
  isActive    Boolean   @default(true)
  note        String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  reservations    Reservation[]
  stays           Stay[]
  cleaningRecords CleaningRecord[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId, state])
}

// 게스트 (호텔 손님). 재방문 가능성 위해 별 모델. Stay 와 1:N.
model Customer {
  id              String   @id @default(cuid())
  hotelId         String
  business        Business @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name            String
  phone           String?
  email           String?
  passportNumber  String?
  passportImageUrl String?
  note            String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdById     String?
  updatedById     String?

  reservations Reservation[]

  @@index([hotelId, name])
  @@index([hotelId, phone])
}

// 예약 (부킹). 기획서 04. 방은 미배정 가능(체크인 때 배정 = roomId nullable).
// 투숙(Stay, 헬스장 read 단일소스)은 체크인 시 생성되는 별 모델 = 05 에서 추가.
model Reservation {
  id                    String        @id @default(cuid())
  hotelId               String
  business              Business      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  // 호텔 자체 예약 번호 (자동 발급). 호텔별 unique.
  reservationNumber     String
  // OTA (Agoda/Trip.com/Naver) 예약 번호 메모. V1 = 자동 연동 X, 매니저 수동 입력.
  otaReservationNumber  String?
  // 룸타입 (필수, 부킹은 타입 기준). 기획서 04 필수값.
  roomTypeId            String
  roomType              RoomType      @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  // 객실 (선택 - 체크인 때 배정). 미배정 예약 허용 = nullable.
  roomId                String?
  room                  Room?         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  customerId            String
  customer              Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // 1박 단위. checkOutDate 는 exclusive (예: 10/02 ~ 10/03 = 10/02 밤만).
  checkInDate           DateTime      @db.Date
  checkOutDate          DateTime      @db.Date
  // 객실료 (PHP). 미리예약은 비워뒀다 체크인 때 확정 가능 = nullable.
  roomPricePhp          Int?
  totalPerson           Int           @default(1)
  // 예약 출처 (Agoda/Trip.com/Walk-in 등). 매출 출처 분석. free-text.
  source                String?
  status                ReservationStatus @default(RESERVED)
  etc                   String?
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)
  createdById           String?
  updatedById           String?

  stay Stay?

  @@unique([hotelId, reservationNumber])
  @@index([hotelId, checkInDate])
  @@index([hotelId, checkOutDate])
  @@index([hotelId, status])
  @@index([roomId, checkInDate])
}

// 투숙 (기획서 05/15). 체크인 시 생성. id = QR 토큰(헬스장이 cross-DB 로 read).
// 호텔이 단일 소스 = 연장/조기퇴실/방변경 시 호텔만 갱신, 동기화 코드 0.
model Stay {
  id            String      @id @default(cuid())
  hotelId       String
  business      Business    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  roomId        String
  room          Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  // 헬스장이 읽는 기간 (checkOutDate exclusive). 레이트체크아웃/방변경 시 갱신.
  checkInDate   DateTime    @db.Date
  checkOutDate  DateTime    @db.Date
  status        StayStatus  @default(ACTIVE)
  checkedInAt   DateTime    @db.Timestamptz(3)
  checkedOutAt  DateTime?   @db.Timestamptz(3)
  // 헬스장 이용 의사 + QR 이메일 발송 시각 (기획서 15).
  gymOptIn      Boolean     @default(false)
  gymQrSentAt   DateTime?   @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)
  createdById   String?
  updatedById   String?

  folio Folio?

  @@index([hotelId, status])
  @@index([roomId, checkInDate])
}

// 정산 (기획서 05). 체크인 시 OPEN 생성, 체크아웃 시 결제수단 + SETTLED.
model Folio {
  id            String         @id @default(cuid())
  hotelId       String
  business      Business       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  stayId        String         @unique
  stay          Stay           @relation(fields: [stayId], references: [id], onDelete: Cascade)
  status        FolioStatus    @default(OPEN)
  paymentMethod PaymentMethod?
  settledAt     DateTime?      @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  createdById   String?
  updatedById   String?

  lines FolioLine[]

  @@index([hotelId, status])
}

// 정산 줄. 유료 룸서비스 항목명·당시가격 스냅샷 (기획서 05). 메뉴 변경과 무관.
model FolioLine {
  id           String   @id @default(cuid())
  folioId      String
  folio        Folio    @relation(fields: [folioId], references: [id], onDelete: Cascade)
  name         String
  unitPricePhp Int
  quantity     Int      @default(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  createdById  String?
  updatedById  String?

  @@index([folioId])
}

// 청소 기록 (기획서 07). 방-담당자 다대다. 보존(삭제 없음).
model CleaningRecord {
  id          String         @id @default(cuid())
  hotelId     String
  business    Business       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId      String
  room        Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  type        CleaningType   @default(CHECKOUT)
  status      CleaningStatus @default(PENDING)
  completedAt DateTime?      @db.Timestamptz(3)
  note        String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  assignees Staff[]

  @@index([hotelId, status])
  @@index([roomId])
}

// 매출 적립 (기획서 14/16). 객실료는 묵은 밤마다 하루치씩 적립(체크아웃 시 생성).
model RevenueEntry {
  id            String         @id @default(cuid())
  hotelId       String
  business      Business       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  date          DateTime       @db.Date
  type          RevenueType
  amountPhp     Int
  paymentMethod PaymentMethod?
  stayId        String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  createdById   String?
  updatedById   String?

  @@index([hotelId, date])
  @@index([hotelId, type])
}

// ─── 구독 / 결제 ───────────────────────────────────────────

model Subscription {
  id          String           @id @default(cuid())
  hotelId     String           @unique
  business    Business         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @default(TRIAL)
  startDate   DateTime         @db.Timestamptz(3)
  endDate     DateTime         @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@index([endDate])
}

model Payment {
  id          String    @id @default(cuid())
  hotelId     String
  business    Business  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amountPhp   Int
  paidAt      DateTime  @db.Timestamptz(3)
  confirmedAt DateTime? @db.Timestamptz(3)
  memo        String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@index([hotelId, paidAt])
}
