# ─────────────────────────────────────────────────────────────
# Total Reservation — environment variables (template)
# Copy to .env for local dev; register the same keys in Vercel for production.
# .env itself is gitignored. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Neon Postgres connection strings (https://neon.tech → project → Connect).
# DATABASE_URL: POOLED connection (host has "-pooler") — used at runtime by
#   the app. PgBouncer transaction mode → faster cold/warm latency, no
#   connection exhaustion under serverless functions.
# DIRECT_URL:   DIRECT connection (no "-pooler") — used by `prisma migrate`.
#   DDL/long transactions need direct because pgbouncer transaction pool can
#   break them. prisma.config.ts reads DIRECT_URL ?? DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# JWT signing secret for auth sessions (32+ random bytes, base64 or hex)
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public base URL — used for email links, OG images, magic links.
# Local: http://localhost:3000
# Vercel preview: auto via VERCEL_URL (handled in code)
# Vercel production: https://yeyakgazua.vercel.app  (later: https://yeyakgazua.com)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Admin bootstrap (used by prisma/seed.ts on first deploy)
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""

# Gmail SMTP (M1 magic link / invite / activation mail)
# GMAIL_APP_PASSWORD = Google account app-specific password (NOT your login pw)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Vercel Blob — 트레이너 사진 등 매장 자원 저장소 (M4)
# Vercel 대시보드 → Storage → Blob → "Create Store" 시 자동 생성됨.
# Production + Preview 두 환경 모두 등록.
BLOB_READ_WRITE_TOKEN=""

# Stripe (M5 — leave empty until then; presence triggers Vercel Pro requirement)
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""
