// Total Reservation — Prisma schema
// M1: gym 가맹점형 SaaS 멀티테넌시. 모든 도메인 row가 gymId(=Business.id) 스코프.
// admin User만 gymId NULL. (email, gymId) composite unique + admin partial unique는
// migration.sql에 raw SQL로 보강 (Postgres NULL distinct 동작 우회).
// 시간 컬럼은 @db.Timestamptz(3) — UTC 저장 명세 부합.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ─────────────────────────────────────────────────

enum Role {
  ADMIN
  OWNER
  MANAGER
  TRAINER
  CUSTOMER
}

enum UserStatus {
  PENDING
  ACTIVE
  WITHDRAWN
  ANONYMIZED
}

enum BusinessStatus {
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  BLOCKED
}

enum BusinessCategory {
  GYM
  MASSAGE
}

enum Gender {
  MALE
  FEMALE
}

enum Specialty {
  HEALTH
  YOGA
  PILATES
  DANCE
}

enum SubscriptionPlan {
  TRIAL
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum ReservationStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
  REJECTED
}

enum ReservationLogAction {
  CREATED
  CONFIRMED
  CHANGED_BY_CUSTOMER
  CHANGED_BY_STAFF
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_STAFF
  REJECTED
  COMPLETED
  NO_SHOW
}

enum MagicLinkPurpose {
  SIGNUP_ACTIVATION
  PASSWORD_RESET
  STAFF_INVITE
}

enum AccessResult {
  ALLOWED
  DENIED
  EXPIRED
}

enum NotificationChannel {
  PUSH
  EMAIL
}

enum NotificationResult {
  SUCCESS
  FAILED
}

// 금액 변경 감사 로그 — 카탈로그 모델별 변경 추적. 신규 모델 추가 시 enum 확장.
enum PriceChangeEntity {
  MEMBERSHIP_PLAN_PRICE
  SERVICE_PRICE
  SERVICE_PAYOUT
  PACKAGE_PLAN_PRICE
  COMBO_PLAN_PRICE
  PROMOTION_VALUE
  STAFF_BASE_SALARY
}

// 환불 대상 종류 — 횟수권 / 회원권.
enum RefundKind {
  PACKAGE
  MEMBERSHIP
}

// 환불 처리 상태 — 미지급(신청됨, 송금 대기) / 완료.
enum RefundStatus {
  PENDING
  COMPLETED
}

// 환불금 수령 방식 — 계좌이체 / 헬스장 직접 수령(카운터 현금/카드).
enum RefundPayoutMethod {
  BANK_TRANSFER
  IN_PERSON
}

// 환불 사유 — 회원 자발 신청(기존)·매장 귀책 자동 환불 식별용.
//   CUSTOMER_REQUEST    : 회원 변심/신청(기본값)
//   CLASS_DISCONTINUED  : 단체수업 1건 폐지
//   SERVICE_DISCONTINUED: 서비스 종목 자체 폐지
//   STAFF_UNAVAILABLE   : 강사 부재로 수업 운영 불가
enum RefundReason {
  CUSTOMER_REQUEST
  CLASS_DISCONTINUED
  SERVICE_DISCONTINUED
  STAFF_UNAVAILABLE
}

// Promotion 적용 범위. 콤보는 자체 할인이라 promotion 적용 제외(의도적 누락).
enum PromotionScope {
  ALL
  MEMBERSHIP_ONLY
  PACKAGE_ONLY
  SPECIFIC_MEMBERSHIP
  SPECIFIC_PACKAGE
}

enum DiscountType {
  PERCENT
  FIXED
}

// 판매 단위 유형. 단품(멤버십/횟수권) 또는 콤보 묶음.
enum SaleType {
  MEMBERSHIP
  PACKAGE
  COMBO
}

enum NotificationChannelSetting {
  PUSH
  EMAIL
  BOTH
}

enum UserDeletionStatus {
  PENDING
  CANCELLED
  ANONYMIZED
}

enum Locale {
  ko
  en
}

enum Weekday {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

enum TimeUnit {
  M30
  M60
}

enum ClosureKind {
  CLOSED
  SHORTENED
}

enum ScheduleKind {
  RECURRING
  ONE_OFF
}

// ─── PSGC Location (글로벌 마스터) ────────────────────────

model City {
  id        String   @id @default(cuid())
  psgcCode  String   @unique
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  barangays   Barangay[]
  businesses  Business[]
  updatedAt   DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?
}

model Barangay {
  id       String @id @default(cuid())
  psgcCode String @unique
  name     String
  cityId   String
  city     City   @relation(fields: [cityId], references: [id])

  businesses  Business[]
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@index([cityId])
}

// ─── Tenant Root: Business (가맹점) ────────────────────────

model Business {
  id           String           @id @default(cuid())
  slug         String           @unique
  name         String
  category     BusinessCategory @default(GYM)
  phone        String?
  contactEmail String?
  hasDeposit   Boolean          @default(false)
  gcashQrUrl   String?
  status       BusinessStatus   @default(TRIAL)
  // IANA 타임존 — 매장 현지 시간 기준(오늘/영업/예약 판정). 기존 매장은
  // 모두 필리핀이라 default Asia/Manila. 등록 시 선택받는다.
  timeZone     String           @default("Asia/Manila")
  cityId       String
  barangayId   String
  city         City             @relation(fields: [cityId], references: [id])
  barangay     Barangay         @relation(fields: [barangayId], references: [id])
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  users               User[]
  staff               Staff[]
  staffLeaves         StaffLeave[]
  services            Service[]
  hours               BusinessHours[]
  closures            BusinessClosure[]
  images              BusinessImage[]
  memberships         Membership[]
  membershipPlans     MembershipPlan[]
  packages            Package[]
  packagePlans        PackagePlan[]
  comboPlans          ComboPlan[]
  promotions          Promotion[]
  reservations        Reservation[]
  reservationLogs     ReservationLog[]
  qrTokens            QrToken[]
  accessLogs          AccessLog[]
  userDeletions       UserDeletion[]
  notificationSetting BusinessNotificationSetting?
  notificationLogs    NotificationLog[]
  subscription        Subscription?
  payments            Payment[]
  magicLinkTokens     MagicLinkToken[]
  inviteToken         InviteToken?
  scheduledClasses    ScheduledClass[]
  priceChangeLogs     PriceChangeLog[]
  refundRequests      RefundRequest[]
  sales               Sale[]
  createdById         String?
  updatedById         String?

  @@index([cityId, barangayId])
  @@index([status])
}

// ─── User (가맹점 스코프, admin만 gymId NULL) ─────────────

model User {
  id                    String     @id @default(cuid())
  gymId                 String?
  business              Business?  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  email                 String?
  passwordHash          String?
  name                  String
  phone                 String?
  gender                Gender?
  dob                   DateTime?  @db.Date
  note                  String?
  emergencyContactPhone String?
  role                  Role       @default(CUSTOMER)
  status                UserStatus @default(PENDING)
  active                Boolean    @default(true)
  locale                Locale     @default(ko)
  // 영구 출입 토큰. 사장이 트레이너 관리에서 "재발급" 시 새 값으로 교체.
  accessToken           String?    @unique
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(3)

  staff               Staff?
  memberships         Membership[]
  packages            Package[]
  refundRequests      RefundRequest[]
  reservations        Reservation[]            @relation("CustomerReservations")
  qrTokens            QrToken[]
  accessLogs          AccessLog[]
  userDeletion        UserDeletion?
  notificationSetting UserNotificationSetting?
  pushSubscriptions   PushSubscription[]
  notificationLogs    NotificationLog[]
  magicLinkTokens     MagicLinkToken[]
  sessions            Session[]
  accounts            Account[]
  sales               Sale[]
  createdById         String?
  updatedById         String?

  @@unique([email, gymId])
  @@index([gymId, role])
  @@index([gymId, status])
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  expiresAt   DateTime @db.Timestamptz(3)
  ipAddress   String?
  userAgent   String?
  rememberMe  Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId  String
  accountId   String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@unique([providerId, accountId])
  @@index([userId])
}

// ─── Tokens ────────────────────────────────────────────────

model MagicLinkToken {
  id           String           @id @default(cuid())
  token        String           @unique
  targetUserId String
  targetUser   User             @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  gymId        String?
  business     Business?        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  purpose      MagicLinkPurpose
  expiresAt    DateTime         @db.Timestamptz(3)
  usedAt       DateTime?        @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  createdById  String?
  updatedById  String?

  @@index([targetUserId, purpose])
  @@index([expiresAt])
}

model InviteToken {
  id                   String    @id @default(cuid())
  token                String    @unique
  expectedBusinessName String?
  expectedOwnerEmail   String?
  expectedOwnerPhone   String?
  expiresAt            DateTime  @db.Timestamptz(3)
  usedAt               DateTime? @db.Timestamptz(3)
  revokedAt            DateTime? @db.Timestamptz(3)
  createdBusinessId    String?   @unique
  createdBusiness      Business? @relation(fields: [createdBusinessId], references: [id])
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  createdById          String?
  updatedById          String?

  @@index([expiresAt])
}

// ─── Staff (가맹점 ↔ User 트레이너·매니저·사장 link) ─────

model Staff {
  id                   String      @id @default(cuid())
  gymId                String
  business             Business    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId               String      @unique
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                 Role
  photoUrl             String?
  bio                  String?
  career               String?
  specialties          Specialty[] @default([])
  customSpecialty      String?
  weeklyOffDays        Weekday[]   @default([])
  // 정기 출근 시간(자정 기준 분, Manila). 기본 10:00~22:00.
  // 가용시간 = gym 영업시간 ∩ [workStartMin, workEndMin] − 휴무/휴가.
  // "새벽 3시 PT" 방지 — 고객 예약 가능 창 산정의 트레이너 측 경계.
  workStartMin         Int?        @default(600)
  workEndMin           Int?        @default(1320)
  // 트레이너 개인 휴게(자정 기준 분, Manila). 보통 없음(null). 있으면 그 구간
  // 슬롯은 예약 불가 — 매장 영업시간 휴게와 별개로 추가 차감.
  breakStartMin        Int?
  breakEndMin          Int?
  // 월 기본급(PHP). 트레이너가 청소·관리 등 수업 외 업무도 수행하기에 고정급
  // 항목이 필요. 0 허용(수업당 payout만 받는 트레이너). 변경 시
  // PriceChangeLog(entityType=STAFF_BASE_SALARY) row 생성.
  monthlyBaseSalaryPhp Int         @default(0)
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)

  reservations     Reservation[]
  images           StaffImage[]
  leaves           StaffLeave[]
  scheduledClasses ScheduledClass[]
  assignedPackages Package[]
  createdById      String?
  updatedById      String?

  @@index([gymId, role])
}

model StaffImage {
  id          String   @id @default(cuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  url         String
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@index([staffId, position])
}

model StaffLeave {
  id          String   @id @default(cuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  gymId       String
  business    Business @relation(fields: [gymId], references: [id], onDelete: Cascade)
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  reason      String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@index([staffId])
  @@index([gymId, endDate])
}

// ─── Service ───────────────────────────────────────────────

model Service {
  id          String   @id @default(cuid())
  gymId       String
  business    Business @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name        String
  capacity    Int      @default(1)
  timeUnit    TimeUnit
  durationMin Int
  pricePhp    Int
  payoutPhp   Int      @default(0)
  deductCount Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  reservations Reservation[]
  packages     Package[]
  packagePlans PackagePlan[]
  schedules    ScheduledClass[]
  createdById  String?
  updatedById  String?

  @@index([gymId])
}

// ─── ScheduledClass ────────────────────────────────────────
// 단체 수업의 정기 운영 schedule. 같은 service를 매주 정해진 요일/시간에
// 반복 운영. 회원은 해당 schedule에 등록(=Reservation row 생성).
//
// 1:1 service는 이 테이블 안 씀 — 회원이 빈 슬롯 자유 예약. capacity ≥ 2
// 인 단체 service만 schedule을 갖는 패턴.

model ScheduledClass {
  id           String       @id @default(cuid())
  gymId        String
  business     Business     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staffId      String?
  staff        Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  kind         ScheduleKind @default(RECURRING)
  // RECURRING: 매주 반복할 요일들. ONE_OFF면 빈 배열.
  weekdays     Weekday[]
  // ONE_OFF: 특정 단발 날짜. RECURRING이면 null.
  specificDate DateTime?    @db.Date
  startMinute  Int
  // RECURRING의 운영 시작일. ONE_OFF는 specificDate와 같은 값으로 기록.
  validFrom    DateTime     @db.Date
  // RECURRING의 운영 종료일 (null=무기한). ONE_OFF는 null.
  validUntil   DateTime?    @db.Date
  active       Boolean      @default(true)
  note         String?
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  reservations Reservation[]
  createdById  String?
  updatedById  String?

  @@index([gymId, serviceId])
  @@index([gymId, active])
  @@index([gymId, specificDate])
}

// ─── Business Hours / Images ───────────────────────────────

model BusinessHours {
  id            String   @id @default(cuid())
  gymId         String
  business      Business @relation(fields: [gymId], references: [id], onDelete: Cascade)
  weekday       Weekday
  openMinute    Int
  closeMinute   Int
  breakStartMin Int?
  breakEndMin   Int?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  createdById   String?
  updatedById   String?

  @@unique([gymId, weekday])
}

// 특정 날짜 단건 override. 같은 날짜에 한 건만 허용 (@@unique).
//   CLOSED    : 전일 휴무 (open/close 무시)
//   SHORTENED : 단축영업 (openMinute, closeMinute 사용)
model BusinessClosure {
  id          String      @id @default(cuid())
  gymId       String
  business    Business    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  date        DateTime    @db.Date
  kind        ClosureKind
  openMinute  Int?
  closeMinute Int?
  reason      String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@unique([gymId, date])
  @@index([gymId, date])
}

model BusinessImage {
  id          String   @id @default(cuid())
  gymId       String
  business    Business @relation(fields: [gymId], references: [id], onDelete: Cascade)
  url         String
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@index([gymId, position])
}

// ─── Membership / Package ──────────────────────────────────

model Membership {
  id          String          @id @default(cuid())
  gymId       String
  business    Business        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate   DateTime        @db.Date
  endDate     DateTime        @db.Date
  pricePhp    Int
  // 발급 원천 추적 — Sale 도입 전 인스턴스는 null. plan 삭제 시 매출은 Sale에 보존.
  planId      String?
  plan        MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  saleId      String?
  sale        Sale?           @relation(fields: [saleId], references: [id], onDelete: SetNull)
  // 환불 신청 시각 — null 이 아니면 환불 진행/완료된 동결 상태.
  refundedAt  DateTime?       @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  refundRequests RefundRequest[]

  @@index([gymId, userId])
  @@index([gymId, endDate])
  @@index([saleId])
}

// ─── MembershipPlan (회원권 카탈로그) ─────────────────────
// 사장이 등록하는 회원권 상품 정의. 기간(일수) + 가격.
// 판매 시 Membership 인스턴스로 발급 — 그 시점 pricePhp가 스냅샷으로 복사.
// pricePhp 변경 시 PriceChangeLog row 자동 생성 (action 레이어에서 처리).
model MembershipPlan {
  id           String   @id @default(cuid())
  gymId        String
  business     Business @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name         String
  durationDays Int
  pricePhp     Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  combos      ComboPlan[]
  memberships Membership[]
  createdById String?
  updatedById String?

  @@index([gymId, active])
}

// ─── PackagePlan (횟수권 카탈로그) ──────────────────────────
// 사장이 등록하는 횟수권 상품 정의. Service FK + 회수 + 총가.
// 1회당 가격은 UI에서 totalPrice/sessionCount로 계산해 표시 (DB 저장 X).
// 트레이너 지급은 Service.payoutPhp 동결 — 콤보 할인에 영향 받지 않음.
// 판매 시 기존 Package 인스턴스 모델로 발급, pricePhp가 스냅샷으로 복사.
model PackagePlan {
  id           String   @id @default(cuid())
  gymId        String
  business     Business @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name         String
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  sessionCount Int
  pricePhp     Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  comboItems  ComboPackageItem[]
  packages    Package[]
  createdById String?
  updatedById String?

  @@index([gymId, active])
  @@index([gymId, serviceId])
}

// ─── ComboPlan (콤보 카탈로그) ──────────────────────────────
// 멤버십 + 패키지 N개 묶음. 콤보 가격은 정상가 합계보다 작음(할인).
// 트레이너 지급은 콤보 할인에 영향 받지 않음 — 콤보가 - 트레이너 지급 = 사장 마진.
// 사장 마진 음수면 저장 차단(action 레이어에서 검증).
model ComboPlan {
  id               String          @id @default(cuid())
  gymId            String
  business         Business        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name             String
  membershipPlanId String?
  membershipPlan   MembershipPlan? @relation(fields: [membershipPlanId], references: [id], onDelete: Restrict)
  pricePhp         Int
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  packageItems ComboPackageItem[]
  createdById  String?
  updatedById  String?

  @@index([gymId, active])
}

// 콤보-패키지 조인. 한 콤보에 같은 PackagePlan 1개만 포함(중복 방지) — composite unique.
model ComboPackageItem {
  id            String      @id @default(cuid())
  comboPlanId   String
  comboPlan     ComboPlan   @relation(fields: [comboPlanId], references: [id], onDelete: Cascade)
  packagePlanId String
  packagePlan   PackagePlan @relation(fields: [packagePlanId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  createdById   String?
  updatedById   String?

  @@unique([comboPlanId, packagePlanId])
  @@index([packagePlanId])
}

// ─── Promotion (이벤트 카탈로그) ────────────────────────────
// 기간 한정 할인. 콤보에는 적용 안 됨(scope에 COMBO 옵션 없음 — 콤보 자체가 할인).
// 회원에게 적용 시 Sale.totalPaid에서만 차감, 트레이너 지급은 영향 X.
// 한 plan에 동시 적용 가능한 promotion이 여러 개일 때 — 가장 큰 할인 자동 선택 (action 레이어).
model Promotion {
  id            String         @id @default(cuid())
  gymId         String
  business      Business       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name          String
  scope         PromotionScope
  targetId      String?
  discountType  DiscountType
  discountValue Int
  startsAt      DateTime       @db.Timestamptz(3)
  endsAt        DateTime       @db.Timestamptz(3)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  sales       Sale[]
  createdById String?
  updatedById String?

  @@index([gymId, active, startsAt, endsAt])
  @@index([gymId, scope, targetId])
}

// ─── PriceChangeLog (금액 변경 감사 로그) ───────────────────
// 가격·payout·할인 등 금액 변경은 모두 row 생성. entityType + entityId는
// soft reference (FK 없음) — 여러 카탈로그 모델을 단일 테이블이 추적.
// 매출 분쟁·세무 감사 시 "언제 누가 얼마에서 얼마로 바꿨나" 추적용.
model PriceChangeLog {
  id          String            @id @default(cuid())
  gymId       String
  business    Business          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  entityType  PriceChangeEntity
  entityId    String
  oldValuePhp Int
  newValuePhp Int
  changedById String?
  changedAt   DateTime          @default(now()) @db.Timestamptz(3)
  note        String?
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@index([gymId, entityType, entityId])
  @@index([gymId, changedAt])
}

// ─── RefundRequest (환불 신청) ─────────────────────────────
// 고객이 횟수권/회원권 잔여분을 환불 신청. 신청 시 권은 동결(refundedAt),
// 미래(내일 이후) 예약은 취소된다. 당일 예약은 완료 취급(환불 제외).
// 금액·횟수는 신청 시점 스냅샷으로 고정(분쟁 추적). 사장이 송금/직접지급
// 후 status=COMPLETED 로 마감. 거절 플로우는 없음.
model RefundRequest {
  id       String   @id @default(cuid())
  gymId    String
  business Business @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind         RefundKind
  // kind 에 따라 하나만 채워진다. 권 삭제 시 환불 기록은 보존(SetNull).
  packageId    String?
  package      Package?    @relation(fields: [packageId], references: [id], onDelete: SetNull)
  membershipId String?
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  // 신청 시점 스냅샷 — 불변. 매출/환불 분쟁 추적용.
  serviceName    String // 서비스명 또는 회원권명
  trainerName    String? // 횟수권 담당 트레이너(회원권은 null)
  paidPhp        Int // 원 결제가
  refundPhp      Int // 환불 금액 (올림 적용)
  // 횟수권: 회 단위 / 회원권: 일 단위. total = completed + today + refund.
  totalUnits     Int
  completedUnits Int // 완료된 수업 / 회원권 경과일
  todayUnits     Int // 당일 예약으로 사용 처리된 횟수 (회원권은 0)
  refundUnits    Int // 환불 대상 횟수 / 회원권 잔여일

  payoutMethod  RefundPayoutMethod
  bankName      String? // BANK_TRANSFER 일 때
  bankAccount   String?
  accountHolder String?

  // 환불 사유. 기본 CUSTOMER_REQUEST(회원 변심), 매장 귀책 자동 환불은
  // CLASS_/SERVICE_/STAFF_ 로 식별 — /refunds 리스트에 사유 표시 + 알림 분기.
  reason        RefundReason @default(CUSTOMER_REQUEST)

  status        RefundStatus @default(PENDING)
  requestedAt   DateTime     @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?    @db.Timestamptz(3)
  completedById String? // 환불 완료를 처리한 staff/owner

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@index([gymId, status, requestedAt])
  @@index([gymId, userId])
  @@index([packageId])
  @@index([membershipId])
}

model Package {
  id              String       @id @default(cuid())
  gymId           String
  business        Business     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service      @relation(fields: [serviceId], references: [id])
  totalCount      Int
  remainingCount  Int
  pricePhp        Int
  // 결제 시점 Service.payoutPhp 스냅샷(frozen). 이후 Service.payoutPhp가 바뀌어도
  // 이미 팔린 패키지의 트레이너 지급액은 불변. 기존 인스턴스 호환 위해 default 0.
  payoutPhp       Int          @default(0)
  // 발급 원천 추적 — Sale 도입 전 인스턴스는 null. plan 삭제 시 매출은 Sale에 보존.
  planId          String?
  plan            PackagePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  saleId          String?
  sale            Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  // 권 단위 담당 트레이너(소프트 기본값). 발급 시 발급 트레이너로 자동 지정 —
  // 고객 화면의 "내 트레이너" 표시 + 예약 변경 시 빈 슬롯 산출의 기준점.
  // 하드 제약 아님: 고객은 다른 트레이너로 분산 예약 가능, staff 비활성 시 SetNull.
  assignedStaffId String?
  assignedStaff   Staff?       @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  // 환불 신청 시각 — null 이 아니면 환불 진행/완료된 동결 상태(예약 불가).
  refundedAt      DateTime?    @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  reservations   Reservation[]
  refundRequests RefundRequest[]
  updatedAt      DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  createdById    String?
  updatedById    String?

  @@index([gymId, userId])
  @@index([saleId])
  @@index([assignedStaffId])
}

// ─── Sale (매출 단일 소스) ──────────────────────────────────
// 한 건의 판매 = 멤버십/횟수권 단품 또는 콤보 묶음. 결제 시점의 금액 산식을
// 전부 스냅샷으로 박제(immutable). 발급된 Membership/Package 인스턴스가
// saleId로 이 row를 가리킴. 환불은 이 row를 수정하지 않고 별도 처리.
// ownerRevenue = totalPaid − payoutLiability. 콤보는 음수면 애초에 저장 차단.
model Sale {
  id                   String     @id @default(cuid())
  gymId                String
  business             Business   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId               String
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  saleType             SaleType
  // 판매 원천 plan (soft ref — PriceChangeLog와 동일 패턴).
  sourcePlanId         String
  // 금액 산식 스냅샷(전부 결제 시점 박제)
  listPricePhp         Int // 정상가 합계
  promotionId          String?
  promotion            Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  promotionDiscountPhp Int        @default(0)
  totalPaidPhp         Int // 실수령 = listPrice − promotionDiscount (콤보면 콤보가)
  payoutLiabilityPhp   Int        @default(0) // 트레이너 지급 총액(frozen 합)
  ownerRevenuePhp      Int // totalPaid − payoutLiability
  soldById             String? // 판매 처리한 owner/staff User.id (soft ref)
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)

  memberships Membership[]
  packages    Package[]
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@index([gymId, createdAt])
  @@index([gymId, saleType])
  @@index([userId])
}

// ─── Reservation ───────────────────────────────────────────

model Reservation {
  id               String            @id @default(cuid())
  gymId            String
  business         Business          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  serviceId        String
  service          Service           @relation(fields: [serviceId], references: [id])
  staffId          String
  staff            Staff             @relation(fields: [staffId], references: [id])
  customerUserId   String
  customer         User              @relation("CustomerReservations", fields: [customerUserId], references: [id])
  startAt          DateTime          @db.Timestamptz(3)
  endAt            DateTime          @db.Timestamptz(3)
  status           ReservationStatus @default(PENDING_PAYMENT)
  depositConfirmed Boolean           @default(false)
  // "수업 완료" 클릭 시각. status=COMPLETED 와 함께 기록. 정산 산식은 후속.
  completedAt      DateTime?         @db.Timestamptz(3)
  // PT 완료 시 트레이너가 남기는 운동 부위 메모(예: "어깨", "하체", "등").
  // 다음 PT 회고용. 빈 값(null) 허용 — 운영 중 빠르게 완료 처리하고
  // 사후에 my-clients 상세에서 입력·수정 가능.
  completionNote   String?
  // 이 예약이 차감하는 PT권/횟수권 인스턴스. 완료 시 Package.remainingCount −= deduct.
  // 권 삭제돼도 예약 원장은 보존(SetNull). 원본(totalCount)은 Package에서 불변.
  packageId        String?
  package          Package?          @relation(fields: [packageId], references: [id], onDelete: SetNull)
  // 정기 단체 수업에서 발생한 예약이면 그 schedule을 가리킴.
  // 1:1 자유 예약은 null. schedule 삭제 시 SetNull로 row는 보존.
  scheduledClassId String?
  scheduledClass   ScheduledClass?   @relation(fields: [scheduledClassId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  logs        ReservationLog[]
  createdById String?
  updatedById String?

  @@index([gymId, status, startAt])
  @@index([gymId, staffId, startAt])
  @@index([gymId, customerUserId])
}

model ReservationLog {
  id            String               @id @default(cuid())
  gymId         String
  business      Business             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  reservationId String
  reservation   Reservation          @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  action        ReservationLogAction
  actorUserId   String?
  occurredAt    DateTime             @default(now()) @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  createdById   String?
  updatedById   String?

  @@index([reservationId])
  @@index([gymId, occurredAt])
}

// ─── Access (QR / AccessLog) ───────────────────────────────

model QrToken {
  id        String    @id @default(cuid())
  gymId     String
  business  Business  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  nonce     String
  issuedAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)

  accessLogs  AccessLog[]
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@index([gymId, userId])
  @@index([expiresAt])
}

model AccessLog {
  id          String       @id @default(cuid())
  gymId       String
  business    Business     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  qrTokenId   String?
  qrToken     QrToken?     @relation(fields: [qrTokenId], references: [id])
  result      AccessResult
  occurredAt  DateTime     @default(now()) @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@index([gymId, occurredAt])
  @@index([gymId, userId, occurredAt])
}

// ─── User Deletion (1달 익명화 cron 대상) ─────────────────

model UserDeletion {
  id          String             @id @default(cuid())
  gymId       String
  business    Business           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedAt DateTime           @default(now()) @db.Timestamptz(3)
  scheduledAt DateTime           @db.Timestamptz(3)
  status      UserDeletionStatus @default(PENDING)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@index([scheduledAt, status])
}

// ─── Notifications ─────────────────────────────────────────

model BusinessNotificationSetting {
  id          String                     @id @default(cuid())
  gymId       String                     @unique
  business    Business                   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  channel     NotificationChannelSetting @default(PUSH)
  updatedAt   DateTime                   @updatedAt @db.Timestamptz(3)
  createdAt   DateTime                   @default(now()) @db.Timestamptz(3)
  createdById String?
  updatedById String?
}

model UserNotificationSetting {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushEnabled  Boolean  @default(true)
  emailEnabled Boolean  @default(true)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  createdById  String?
  updatedById  String?
}

model PushSubscription {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint    String   @unique
  p256dhKey   String
  authKey     String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@index([userId])
}

model NotificationLog {
  id              String              @id @default(cuid())
  gymId           String
  business        Business            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  recipientUserId String
  recipient       User                @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  kind            String
  channel         NotificationChannel
  result          NotificationResult
  fallback        Boolean             @default(false)
  sentAt          DateTime            @default(now()) @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  createdById     String?
  updatedById     String?

  @@index([gymId, sentAt])
  @@index([recipientUserId, sentAt])
}

// ─── Subscription / Payment (가맹점 구독료) ────────────────

model Subscription {
  id          String           @id @default(cuid())
  gymId       String           @unique
  business    Business         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @default(TRIAL)
  startDate   DateTime         @db.Timestamptz(3)
  endDate     DateTime         @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@index([endDate])
}

model Payment {
  id          String    @id @default(cuid())
  gymId       String
  business    Business  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  amountPhp   Int
  paidAt      DateTime  @db.Timestamptz(3)
  confirmedAt DateTime? @db.Timestamptz(3)
  memo        String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?
  updatedById String?

  @@index([gymId, paidAt])
}
